class Solution {
    public int[] sortArrayByParity(int[] nums) {
        int even = 0, odd = nums.length-1;
        while(even < odd){
            if(nums[even]%2 != 0){
                if(nums[odd] % 2 == 0){
                    swap(nums, odd, even);
                    even++; odd--;
                }else{
                    odd--;
                }
            }else{
                even++;
            }
        }
        return nums;
    }
    private void swap(int[] nums, int i, int j){
        int temp = nums[i];
        nums[i] = nums[j];
        nums[j] = temp;

    }
}

Time : O(n)
