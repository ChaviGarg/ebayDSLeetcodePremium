class CustomStack {

    int[] stack;
    int topIndex = -1;

    public CustomStack(int maxSize) {
        stack = new int[maxSize];
    }
    
    public void push(int x) {
        if(topIndex < stack.length-1){
            topIndex += 1;
            stack[topIndex] = x;
        }
    }
    
    public int pop() {
        int removed = -1;
        System.out.println("topIdx " + topIndex);
        if(stack.length > 0 && topIndex >= 0){
            removed = stack[topIndex];
            topIndex--;
        }
        return removed;
    }
    
    public void increment(int k, int val) {
        for(int i=0; i < k && i < stack.length; i++){
            stack[i] = stack[i]+val;
        }
    }
}

