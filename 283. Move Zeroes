class Solution {
    public void moveZeroes(int[] nums) {
        int lastNonZeroIndex = 0;
        for(int i=0; i < nums.length; i++){
            if(nums[i] != 0){
                swap(i, lastNonZeroIndex, nums);
                lastNonZeroIndex++;
            }
        }
    }
    private void swap(int i, int lastNonZeroIndex, int[] nums){
        int temp = nums[i];
        nums[i] = nums[lastNonZeroIndex];
        nums[lastNonZeroIndex] = temp;
    }
}
